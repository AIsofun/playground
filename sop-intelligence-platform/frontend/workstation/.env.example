# REST API 根地址（禁止在代码中硬编码；见 docs/module-specs/workstation-ui.md §5.1）
# 示例不含尾斜杠；与后端实际端口一致即可
VITE_API_BASE_URL=http://localhost:8000

# WebSocket 根地址（§5.2：与 /ws/workstation/{workstation_id} 拼接）
# 使用 ws:// 或 wss://，不含路径
VITE_WS_BASE_URL=ws://localhost:8000

# 可选：演示页视频地址（外链 mp4 或 / 开头的本地 public 文件）
# VITE_DEMO_VIDEO_URL=/demo-sop-guide.mp4
